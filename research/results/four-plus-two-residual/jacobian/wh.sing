ring r = 0,(X0,X1,Y0,Y1,s,t),dp;
poly H = X0^6 + 5/7*X0^5*X1 + 5/7*X0^3*X1*Y0*Y1 + 10/7*X0*X1^5 + 10/7*X0*X1*Y0^3*Y1 + X1^6 + Y0^6 + 5/7*Y0^5*Y1 + 15/7*Y0*Y1^5 + Y1^6;
poly W = H + s^3 + t^3;
ideal J = jacob(W);
ideal G = std(J);
"dim of V(jacob(W)) in A^6 (0 = only origin):", dim(G);
"vdim (Milnor number, expect 5^4*2*2=2500):", vdim(G);
ring r4 = 0,(X0,X1,Y0,Y1),dp;
poly H = X0^6 + 5/7*X0^5*X1 + 5/7*X0^3*X1*Y0*Y1 + 10/7*X0*X1^5 + 10/7*X0*X1*Y0^3*Y1 + X1^6 + Y0^6 + 5/7*Y0^5*Y1 + 15/7*Y0*Y1^5 + Y1^6;
ideal G4 = std(jacob(H));
"dim V(jacob(H)) in A^4:", dim(G4), " vdim (expect 625):", vdim(G4);
// also check H mod small primes for use later: is S_H smooth mod 13,19,31?
ring r13 = 13,(X0,X1,Y0,Y1),dp;
poly H = X0^6 + 5/7*X0^5*X1 + 5/7*X0^3*X1*Y0*Y1 + 10/7*X0*X1^5 + 10/7*X0*X1*Y0^3*Y1 + X1^6 + Y0^6 + 5/7*Y0^5*Y1 + 15/7*Y0*Y1^5 + Y1^6;
"mod 13 dim V(jacob H):", dim(std(jacob(H)));
quit;
