// Double-plane models of the base changes Sigma_n (kappa = rho^n): v^2 = (H + C u)^2 - 4 u^6 with
// (C,H) = (rho^a, rho^b), 3a-2b = n; branch curve B = (H+Cu-2u^3)(H+Cu+2u^3) homogenised in P^2(rho:u:z).
// For each n: degree of B, singular points, Tjurina numbers, Hessian rank => simple (ADE) or not.
LIB "sing.lib"; LIB "primdec.lib";
ring r = (0,i),(rho,u,z),dp; minpoly = i^2+1;
proc analyse(int n, int a, int b)
{
  poly Hh = rho^b; poly Cc = rho^a;
  poly fp = Hh + Cc*u - 2*u^3; poly fm = Hh + Cc*u + 2*u^3;
  // homogenise both cubic/quartic factors to a common degree
  int dp_ = deg(fp); int dm_ = deg(fm); int d = dp_; if (dm_ > d) { d = dm_; }
  poly Fp = homog(fp, z); poly Fm = homog(fm, z);
  if (deg(Fp) < d) { Fp = Fp*z^(d-deg(Fp)); }
  if (deg(Fm) < d) { Fm = Fm*z^(d-deg(Fm)); }
  poly B = Fp*Fm;
  "n=",n," (a,b)=(",a,",",b,")  deg B =", deg(B), "  K_doubleplane = O(", deg(B) div 2 - 3, ")";
  ideal S = std(ideal(B, diff(B,rho), diff(B,u), diff(B,z)));
  list L = minAssGTZ(S);
  int k;
  for (k=1; k<=size(L); k++) {
    // local analysis at the point: choose an affine chart where the point is finite
    ideal P = std(L[k]);
    "   singular point ideal:", string(P);
  }
}
analyse(2,2,2); analyse(3,1,0); analyse(4,2,1); analyse(5,3,2); analyse(6,2,0);
// local types: Tjurina numbers at the listed points (affine charts chosen by hand below)
proc loc(poly B, string lab)
{
  ring rl = (0,i),(x,y),ds; minpoly = i^2+1;
  poly G = imap(r, B);
  ideal T = std(ideal(G, diff(G,x), diff(G,y)));
  "   ", lab, ": mult=", mult(std(G)), " tjurina=", vdim(T), " milnor=", vdim(std(jacob(G))), " jet3=", jet(G,3);
  kill rl;
}
// n=2: B = (rho^2(z+u) - 2u^3)(rho^2(z+u)+2u^3): points (0:0:1) [chart z=1: x=rho,y=u] and (1:0:0) [chart rho=1: x=u, y=z]
poly B2 = (rho^2*(z+u) - 2*u^3)*(rho^2*(z+u) + 2*u^3);
ring r2 = (0,i),(x,y),ds; minpoly=i^2+1;
poly G = subst(subst(subst(imap(r,B2), rho, x), u, y), z, 1);
"n=2 at (0:0:1): mult=", mult(std(G)), " tjurina=", vdim(std(ideal(G,diff(G,x),diff(G,y))));
poly G2 = subst(subst(subst(imap(r,B2), rho, 1), u, x), z, y);
"n=2 at (1:0:0): mult=", mult(std(G2)), " tjurina=", vdim(std(ideal(G2,diff(G2,x),diff(G2,y))));
setring r;
poly B3 = (z^3 + rho*u*z - 2*u^3)*(z^3 + rho*u*z + 2*u^3);
setring r2;
poly G3 = subst(subst(subst(imap(r,B3), rho, 1), u, x), z, y);
"n=3 at (1:0:0): mult=", mult(std(G3)), " tjurina=", vdim(std(ideal(G3,diff(G3,x),diff(G3,y)))), " jet2=", jet(G3,2);
setring r;
poly B4 = (rho*z^2 + rho^2*u - 2*u^3)*(rho*z^2 + rho^2*u + 2*u^3);
setring r2;
poly G4a = subst(subst(subst(imap(r,B4), rho, x), u, y), z, 1);
"n=4 at (0:0:1): mult=", mult(std(G4a)), " tjurina=", vdim(std(ideal(G4a,diff(G4a,x),diff(G4a,y))));
poly G4b = subst(subst(subst(imap(r,B4), rho, 1), u, x), z, y);
"n=4 at (1:0:0): mult=", mult(std(G4b)), " tjurina=", vdim(std(ideal(G4b,diff(G4b,x),diff(G4b,y))));
setring r;
poly B5 = (rho^2*z^2 + rho^3*u - 2*u^3*z)*(rho^2*z^2 + rho^3*u + 2*u^3*z);
setring r2;
poly G5a = subst(subst(subst(imap(r,B5), rho, x), u, y), z, 1);
"n=5 at (0:0:1): mult=", mult(std(G5a)), " tjurina=", vdim(std(ideal(G5a,diff(G5a,x),diff(G5a,y)))), " jet4=", jet(G5a,4);
poly G5b = subst(subst(subst(imap(r,B5), rho, 1), u, x), z, y);
"n=5 at (1:0:0): mult=", mult(std(G5b)), " tjurina=", vdim(std(ideal(G5b,diff(G5b,x),diff(G5b,y))));
poly G5c = subst(subst(subst(imap(r,B5), rho, x), u, 1), z, y);
"n=5 at (0:1:0): mult=", mult(std(G5c)), " tjurina=", vdim(std(ideal(G5c,diff(G5c,x),diff(G5c,y))));
setring r;
poly B6 = (z^3 + rho^2*u - 2*u^3)*(z^3 + rho^2*u + 2*u^3);
setring r2;
poly G6 = subst(subst(subst(imap(r,B6), rho, 1), u, x), z, y);
"n=6 at (1:0:0): mult=", mult(std(G6)), " tjurina=", vdim(std(ideal(G6,diff(G6,x),diff(G6,y))));
quit;
