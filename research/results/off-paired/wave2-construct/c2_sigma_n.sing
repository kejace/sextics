// Singularities and p_g of the base-changed genus-2 surfaces
// Sigma_n : (1+w)(1-s^2) = 2 rho^n w^3 (1+s^2)  in (P^1)^3, tridegree (n,3,2).
// Check singular points on all 8 affine charts (rho or 1/rho, w or 1/w, s or 1/s).
LIB "primdec.lib";
proc chk(int n)
{
  ring r = 0,(a,b,c),dp; // a = rho-coordinate, b = w-coordinate, c = s-coordinate in a chart
  int ia, ib, ic; poly G; ideal J; list L; int tot = 0;
  for (ia=0; ia<=1; ia++) { for (ib=0; ib<=1; ib++) { for (ic=0; ic<=1; ic++) {
    // homogeneous form: (w0+w1) w0^2 (s0^2 - s1^2) r0^n - 2 r1^n w1^3 (s0^2+s1^2)
    poly r0,r1,w0,w1,s0,s1;
    if (ia==0) { r0=1; r1=a; } else { r0=a; r1=1; }
    if (ib==0) { w0=1; w1=b; } else { w0=b; w1=1; }
    if (ic==0) { s0=1; s1=c; } else { s0=c; s1=1; }
    G = (w0+w1)*w0^2*(s0^2-s1^2)*r0^n - 2*r1^n*w1^3*(s0^2+s1^2);
    J = G, diff(G,a), diff(G,b), diff(G,c);
    J = std(J);
    if (dim(J) > 0) {
      // affine dim 0 means finitely many singular points; dim(J) counts Krull dim of r/J (0 = points, -1 = empty)
      L = primdecGTZ(J);
      "n=",n," chart(",ia,ib,ic,") singular components:", size(L), " dim:", dim(J);
      int k; for (k=1;k<=size(L);k++) { "   prime:", L[k][2]; }
      tot = tot + size(L);
    }
    else { if (dim(J) == 0) { L = primdecGTZ(J); "n=",n," chart(",ia,ib,ic,") isolated singular pts (components):", size(L); int k2; for (k2=1;k2<=size(L);k2++) { "   prime:", L[k2][2], " mult:", vdim(std(L[k2][1])); } tot = tot+size(L); } }
  } } }
  "n=",n," total singular components over charts:", tot;
}
chk(1); chk(2); chk(3); chk(6);
quit;
