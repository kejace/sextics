LIB "primdec.lib";
ring r = 0, (t0,t1), dp;
ideal J2 = (-155618117875928688652800000)*t1*t1,
(17290901986214298739200000)*t1*t1,
(-853871703022928332800000)*t0*t0+(-11527267990809532492800000)*t0*t1+(466854353627786065958400000)*t1*t1,
(-853871703022928332800000)*t0*t0+(-11527267990809532492800000)*t0*t1+(466854353627786065958400000)*t1*t1,
(853871703022928332800000)*t0*t0+(11527267990809532492800000)*t0*t1+(-466854353627786065958400000)*t1*t1,
(-11527267990809532492800000)*t0*t0,
(11527267990809532492800000)*t0*t0,
(57636339954047662464000000)*t0*t0,
(69163607944857194956800000)*t0*t0,
(-23054535981619064985600000)*t0*t0+(1867417414511144263833600000)*t0*t1+(-37815202643850671342630400000)*t1*t1;
ideal G = std(J2);
int dm = dim(G);
print("DIMJ2 " + string(dm));
if (dm > 0) {
  list L = minAssGTZ(J2);
  int i; int j;
  for (i = 1; i <= size(L); i++) {
    string s = "COMP " + string(i) + ":";
    for (j = 1; j <= size(L[i]); j++) { s = s + " " + string(L[i][j]) + " ;"; }
    print(s);
  }
}
quit;
