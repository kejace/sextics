LIB "primdec.lib";
ring r = 0, (t0,t1), dp;
ideal J2 = (-349920000)*t0*t0,
(-233280000)*t0*t0,
(2799360000)*t0*t0,
(16796160000)*t1*t1,
(16796160000)*t1*t1,
(-16796160000)*t1*t1,
(-16796160000)*t0*t1,
(16796160000)*t0*t1,
(16796160000)*t0*t1,
(16796160000)*t0*t1,
(16796160000)*t0*t1,
(-12597120000)*t0*t1,
(-83980800000)*t1*t1,
(16796160000)*t0*t1,
(46189440000)*t0*t1,
(75582720000)*t0*t1,
(-2019738240000)*t0*t1;
ideal G = std(J2);
int dm = dim(G);
print("DIMJ2 " + string(dm));
if (dm > 0) {
  list L = minAssGTZ(J2);
  int i; int j;
  for (i = 1; i <= size(L); i++) {
    string s = "COMP " + string(i) + ":";
    for (j = 1; j <= size(L[i]); j++) { s = s + " " + string(L[i][j]) + " ;"; }
    print(s);
  }
}
quit;
