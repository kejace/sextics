LIB "primdec.lib";
ring r = 0, (t0,t1), dp;
ideal J2 = (-73200083927040000)*t0*t0,
(-6506674126848000)*t0*t1,
(-117120134283264000)*t1*t1,
(-6588007553433600000)*t1*t1,
(4743365438472192000)*t0*t1,
(-758938470155550720000)*t1*t1,
(13176015106867200000)*t1*t1,
(-23716827192360960000)*t1*t1,
(23716827192360960000)*t1*t1,
(77079688375173120000)*t1*t1,
(4743365438472192000)*t0*t1,
(-499301625102336000)*t0*t1,
(-505958980103700480000)*t1*t1,
(-499301625102336000)*t0*t1,
(499301625102336000)*t0*t1,
(-499301625102336000)*t0*t1,
(1976402266030080000)*t1*t1,
(-31622436256481280000)*t1*t1,
(1997206500409344000)*t0*t1,
(-9486730876944384000)*t0*t1,
(-1747555687858176000)*t0*t1,
(-748952437653504000)*t0*t1,
(15811218128240640000)*t1*t1,
(-15811218128240640000)*t1*t1,
(-499301625102336000)*t0*t1,
(-2246857312960512000)*t0*t1,
(2746158938062848000)*t0*t1,
(-7083425721451806720000)*t1*t1,
(117925335206461440000)*t1*t1;
ideal G = std(J2);
int dm = dim(G);
print("DIMJ2 " + string(dm));
if (dm > 0) {
  list L = minAssGTZ(J2);
  int i; int j;
  for (i = 1; i <= size(L); i++) {
    string s = "COMP " + string(i) + ":";
    for (j = 1; j <= size(L[i]); j++) { s = s + " " + string(L[i][j]) + " ;"; }
    print(s);
  }
}
quit;
