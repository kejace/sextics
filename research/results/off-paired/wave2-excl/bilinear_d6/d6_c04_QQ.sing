ring r = 0,(t0,s0,s1,s2,s3,s4,s5,s6),dp;
option(redSB);
ideal I = -1*t0*s2,
(-9/4)*t0*s0+1*t0*s4+-1*t0*s5,
1*t0*s4+-1*t0*s6,
1*t0*s1+2*t0*s4+-1*t0*s5,
(-1/4)*t0*s2,
(-1/4)*t0*s2,
(-1/4)*t0*s2,
(-3/16)*t0*s0+(1/12)*t0*s1+(1/4)*t0*s3+(1/2)*t0*s4+(-1/6)*t0*s5,
1*t0*s2,
(-1/8)*t0*s2,
1*t0*s3+1*t0*s4,
(-1/4)*t0*s2,
(-9/4)*t0*s2,
3*t0*t0,
(9/16)*t0*s2,
(9/4)*t0*s2,
(27/8)*t0*t0,
(1/4)*t0*s0+(1/6)*t0*s1+(1/18)*t0*s3+(1/3)*t0*s4+(-1/18)*t0*s5+(-1/18)*t0*s6,
(-1/12)*t0*s2,
-36*t0*s0,
(3/8)*t0*s0+(1/4)*t0*s1+(1/12)*t0*s3+(1/2)*t0*s4+(-1/12)*t0*s5+(-1/12)*t0*s6,
-3*t0*s0,
(-1/8)*t0*s2,
-27*t0*s1+9*t0*s3+-9*t0*s5+-9*t0*s6,
(-9/4)*t0*s1+(3/4)*t0*s3+(-3/4)*t0*s5+(-3/4)*t0*s6,
-27*t0*t0,
(-3/4)*t0*s0+(-1/2)*t0*s1+(1/2)*t0*s3+1*t0*s4+(-1/2)*t0*s5+(-1/2)*t0*s6,
(-1/4)*t0*s2;
int t0 = timer; int bad = 0; ideal G; ideal J; int a;
for (a = 1; a <= 1; a++) {
  J = I; int b; for (b = 1; b < a; b++) { J = J + ideal(var(b)); } kill b;
  J = J + ideal(var(a) - 1);
  G = std(J);
  if (size(G)==1 and deg(G[1])==0) { print("chart " + string(a) + ": UNIT"); } else { bad = bad + 1; print("chart " + string(a) + ": NONUNIT dim=" + string(dim(G)) + " size=" + string(size(G))); }
}
if (bad == 0) { print("ALL-UNIT"); } else { print("SOME-NONUNIT"); }
print("seconds=" + string(timer-t0));
quit;
