ring r = 0,(t0,s0,s1,s2,s3,s4,s5,s6,s7,s8,s9,s10,s11,s12,s13,s14),dp;
option(redSB);
ideal I = 1*t0*s3+-1*t0*s4,
1*t0*s3+-1*t0*s5,
1*t0*s3+-1*t0*s6,
(-9/4)*t0*s0+1*t0*s9+-1*t0*s10,
