(3/8)*t0*s0+(1/4)*t0*s1+(1/12)*t0*s7+(1/2)*t0*s9+(-1/12)*t0*s10+(-1/12)*t0*s11,
-3*t0*s0+(1/18)*t0*s13+(-1/24)*t0*s14,
