-1*t0*s13+(9/4)*t0*s14,
2*t0*s13,
(3/8)*t0*s3+(-3/16)*t0*s4+(9/16)*t0*s5+(-3/4)*t0*s6+(1/6)*t0*s8,
(9/4)*t0*s12,
(1/6)*t0*s13+(-3/8)*t0*s14,
(9/4)*t0*s5+(-9/4)*t0*s6+1*t0*s8+(3/16)*t0*s12,
(-9/4)*t0*s8,
(27/8)*t0*t0,
(2/3)*t0*s2+(5/18)*t0*s3+(-1/18)*t0*s4+(-1/18)*t0*s6,
(1/4)*t0*s0+(1/6)*t0*s1+(1/18)*t0*s7+(1/3)*t0*s9+(-1/18)*t0*s10+(-1/18)*t0*s11,
(9/2)*t0*s13,
