1*t0*s1+2*t0*s9+-1*t0*s10,
-2*t0*s14,
-1*t0*s12,
1*t0*s2+(5/12)*t0*s3+(-1/3)*t0*s4+(1/4)*t0*s5+(-1/12)*t0*s6,
(-3/16)*t0*s0+(1/12)*t0*s1+(1/4)*t0*s7+(1/2)*t0*s9+(-1/6)*t0*s10,
