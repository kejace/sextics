ring r = 0, (c1,c2), dp;
ideal I = (-)*c1^2+(-)*c1*c2+(-)*c2^2,
(-)*c1^2+(-)*c1*c2+()*c2^2,
(-)*c1^2+()*c1*c2+(-)*c2^2,
(-)*c1^2+(-)*c1*c2+()*c2^2,
(-)*c1^2+(-)*c1*c2+()*c2^2,
()*c1^2+()*c1*c2+(-)*c2^2,
(-)*c1^2+(-)*c1*c2+(-)*c2^2;
ideal G = std(I); "DIM", dim(G); if (dim(G) <= 1) { "VDIM", vdim(G); }
quit;
