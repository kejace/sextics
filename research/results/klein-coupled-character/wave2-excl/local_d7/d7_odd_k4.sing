ring R = 1000003, (u0,u1,u2,u3,u4,u5), dp;
ideal I = 30*u5^2,
30*u4^2,
30*u3^2,
285728*u0*u3,
285728*u1*u3,
285728*u1*u5+551019*u3*u5,
285728*u2*u5,
1000001*u0*u5+1000001*u2*u3+142859*u3*u4,
285728*u0^2,
571456*u0*u1,
285728*u1^2,
571456*u0*u2,
571456*u1*u2,
285728*u2^2,
999993*u0*u5+999993*u2*u3,
20*u0^2,
40*u0*u1+102035*u3*u5,
20*u1^2,
40*u1*u2,
20*u2^2,
333241*u0*u2+285718*u4*u5,
