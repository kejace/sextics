ring R = 1000003, (u0,u1,u2), dp;
ideal I = 102035*u0^2,
81638*u0*u2,
999993*u2^2,
571396*u0*u2,
428577*u0*u1+714275*u2^2,
8*u1*u2,
612210*u0^2,
387793*u2^2,
163276*u0*u2,
20*u0^2+999993*u1*u2,
999953*u0*u2+20*u1^2,
714245*u0^2+714285*u1*u2,
857184*u2^2,
428587*u0*u2+428577*u1^2,
10*u0*u1+999997*u2^2;
ideal SI = std(I);
"n_gens", size(I), "gb_size", size(SI), "dim", dim(SI), "vdim", vdim(SI);
LIB "primdec.lib";
list L = minAssGTZ(I);
"n_components", size(L);
int i; for (i=1;i<=size(L);i++) { "component", i, "dim", dim(std(L[i])); print(L[i]); }
quit;
