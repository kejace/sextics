ring r = 32003, (u0,u1,u2), dp;
option(redSB);
ideal I = 31983*u0*u0,
22855*u0*u0,
21270*u0*u1+21270*u1*u0,
22855*u0*u1+22855*u1*u0,
31975*u0*u1+31975*u1*u0,
120*u0*u1+120*u1*u0,
140*u0*u1+140*u1*u0,
4254*u0*u1+4254*u1*u0,
31983*u0*u2+31983*u2*u0,
7839*u0*u2+7839*u2*u0,
2613*u0*u2+2613*u2*u0,
31983*u1*u1,
22855*u1*u1,
31983*u1*u2+31983*u2*u1,
7839*u1*u2+7839*u2*u1,
2613*u1*u2+2613*u2*u1,
4579*u2*u2,
31132*u2*u2,
8710*u2*u2,
21337*u2*u2;
ideal G = std(I);
int dm = dim(G);
print("DIM " + string(dm) + " GBSIZE " + string(size(G)) + " VARS " + string(nvars(r)) + " NEQ " + string(size(I)));
if (dm == 0) { print("VDIM " + string(vdim(G))); }
quit;
