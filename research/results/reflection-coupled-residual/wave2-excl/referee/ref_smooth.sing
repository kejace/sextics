// Referee: smoothness of the six coordinate sections X cap {z_i = 0} mod p (Jacobian ideal of the restricted sextic is m-primary)
int p = 1000003;
ring r = p, (X0,X1,X2,Y0,Y1,Y2), dp;
poly F = X0^6 + 5*X0^3*X1*Y0*Y1/7 + 5*X0*X1*Y0^3*Y1/7 + 5*X0*X1*Y0^2*Y2^2/7 + 10*X0*X1*Y1^2*Y2^2/7 + 15*X0*X2^3*Y0*Y1/7 + X1^6 + 10*X1^3*X2*Y0*Y1/7 + 5*X1*X2*Y0*Y1^3/7 + X2^6 + Y0^6 + Y1^6 + Y2^6;
// sanity: the fourfold itself
ideal JX = jacob(F); JX = std(JX); print("X: dim(cone) = " + string(dim(JX)) + " vdim = " + string(vdim(JX)));
int i;
for (i = 1; i <= 6; i++) {
  poly G = subst(F, var(i), 0);
  ideal J = jacob(G), var(i);   // partials of the restricted sextic in the remaining 5 variables, plus z_i itself
  J = std(J);
  print("section z" + string(i) + "=0: dim(cone) = " + string(dim(J)) + " vdim = " + string(vdim(J)));
}
quit;
