// Exact (char 0) membership A*K8 in J(F): reduce with a degree-truncated standard basis of J.
// reduce(...)==0 proves membership unconditionally (G subset J); nonzero would be inconclusive.
ring r = 0, (X0,X1,X2,Y0,Y1,Y2), dp;
poly K8 = (-75/196)*X0^8 + (-10609/1764)*X0^6*X1^2 + (-1)*X0^6*Y1^2 + (-625/4116)*X0^5*X1*Y0*Y1 + (-25/441)*X0^4*X1^2*Y0^2 + (-25/294)*X0^4*X1*X2^3 + (5/14)*X0^4*X2^2*Y0*Y1 + (-25/441)*X0^3*X1^4*X2 + (-15/7)*X0^3*X1^3*Y0*Y1 + (-25/441)*X0^3*X1^2*X2*Y1^2 + (-125/2058)*X0^3*X1*Y0^3*Y1 + (-125/2058)*X0^3*X1*Y0^2*Y2^2 + (-5/14)*X0^3*X1*Y0*Y1^3 + (-125/1029)*X0^3*X1*Y1^2*Y2^2 + (-25/196)*X0^2*X1^6 + (-125/2058)*X0^2*X1^3*X2*Y0*Y1 + (-25/588)*X0^2*X1^2*Y0^4 + (50/441)*X0^2*X1^2*Y2^4 + (-25/147)*X0^2*X1*X2^3*Y0^2 + (5/14)*X0^2*X2^2*Y0^3*Y1 + (5/14)*X0^2*X2^2*Y0^2*Y2^2 + (5/7)*X0^2*X2^2*Y1^2*Y2^2 + (3)*X0*X1^5*X2^2 + (-50/441)*X0*X1^4*X2*Y0^2 + (-25/147)*X0*X1^3*X2^4 + (-5/7)*X0*X1^3*Y0^3*Y1 + (-5/7)*X0*X1^3*Y0^2*Y2^2 + (-10/7)*X0*X1^3*Y1^2*Y2^2 + (-125/882)*X0*X1^2*X2*Y0^2*Y1^2 + (-25/147)*X0*X1*X2^4*Y1^2 + (10/21)*X0*X1*Y0^4*Y2^2 + (-5/42)*X0*X1*Y0^3*Y1^3 + (-5/42)*X0*X1*Y0^2*Y1^2*Y2^2 + (-25/441)*X1^6*X2^2 + (-50/441)*X1^4*X2^2*Y1^2 + (-25/588)*X1^2*X2^2*Y1^4 + (1)*Y0^4*Y1^4;
poly F = (1)*X0^6 + (5/7)*X0^3*X1*Y0*Y1 + (5/7)*X0*X1*Y0^3*Y1 + (5/7)*X0*X1*Y0^2*Y2^2 + (10/7)*X0*X1*Y1^2*Y2^2 + (15/7)*X0*X2^3*Y0*Y1 + (1)*X1^6 + (10/7)*X1^3*X2*Y0*Y1 + (5/7)*X1*X2*Y0*Y1^3 + (1)*X2^6 + (1)*Y0^6 + (1)*Y1^6 + (1)*Y2^6;
poly A = (1)*X0^3*Y0^3;
ideal J = jacob(F);
option(redSB);
degBound = 14;
int t0 = timer;
ideal G = std(J);
"std(J) truncated at degree 14 over Q: size", size(G), " time", timer - t0;
"max degree in G:"; int i; int md = 0; for (i = 1; i <= size(G); i++) { if (deg(G[i]) > md) { md = deg(G[i]); } } md;
poly nf = reduce(A*K8, G);
"normal form of A*K8 (0 means A*K8 in J over Q):"; nf;
"size(nf):"; size(nf);
// sanity: A itself is not in J
"normal form of A (should be nonzero):"; size(reduce(A, G));
quit;
