// Fully independent Singular computation: full standard basis of J mod 1000003, colon ideal (J : A),
// and Klein-character counts of standard monomials in degrees 1..10  =>  E1 kernels by character.
ring r = 1000003, (X0,X1,X2,Y0,Y1,Y2), dp;
poly F = (1)*X0^6 + (5/7)*X0^3*X1*Y0*Y1 + (5/7)*X0*X1*Y0^3*Y1 + (5/7)*X0*X1*Y0^2*Y2^2 + (10/7)*X0*X1*Y1^2*Y2^2 + (15/7)*X0*X2^3*Y0*Y1 + (1)*X1^6 + (10/7)*X1^3*X2*Y0*Y1 + (5/7)*X1*X2*Y0*Y1^3 + (1)*X2^6 + (1)*Y0^6 + (1)*Y1^6 + (1)*Y2^6;
poly A = (1)*X0^3*Y0^3;
ideal J = jacob(F);
option(redSB);
int t0 = timer;
ideal G = std(J);
"full std(J): size", size(G), " time", timer - t0;
"dim/vdim:", dim(G), vdim(G);
t0 = timer;
ideal Q = quotient(G, ideal(A));
Q = std(Q);
"std(J:A): size", size(Q), " time", timer - t0;
int d; int i; intvec e;
for (d = 1; d <= 10; d++) {
  ideal kJ = kbase(G, d); ideal kQ = kbase(Q, d);
  intvec cJ = 0,0,0,0; intvec cQ = 0,0,0,0;
  for (i = 1; i <= size(kJ); i++) { e = leadexp(kJ[i]); cJ[1 + (e[6] % 2) * 2 + ((e[4]+e[5]) % 2)] = cJ[1 + (e[6] % 2) * 2 + ((e[4]+e[5]) % 2)] + 1; }
  for (i = 1; i <= size(kQ); i++) { e = leadexp(kQ[i]); cQ[1 + (e[6] % 2) * 2 + ((e[4]+e[5]) % 2)] = cQ[1 + (e[6] % 2) * 2 + ((e[4]+e[5]) % 2)] + 1; }
  "d=" + string(d) + " dim(S/J) by char (00,01,10,11): " + string(cJ) + "  dim(S/(J:A)) by char: " + string(cQ) + "  E1-kernel mod J by char: " + string(cJ - cQ);
}
quit;
