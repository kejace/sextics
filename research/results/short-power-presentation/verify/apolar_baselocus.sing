ring R = 0, (u0,u1,u2,u3,u4,u5), dp;
ideal I = u3*u5 - u4*u5/3,
u3*u4 - u4*u5/5,
u2*u4 - 3*u2*u5/5,
u2*u3 - u2*u5/5,
u1*u5 - 2*u2*u5/3,
u1*u4 - 2*u2*u5/5,
u1*u3 - 2*u2*u5/15,
u1*u2 - 2*u4*u5/5,
u0*u5 - u2*u5/3,
u0*u4 - u2*u5/5,
u0*u3 - u2*u5/15,
u0*u2 - u4*u5/5,
u0*u1 - 2*u4*u5/15;
ideal G = std(I); print("dim = " + string(dim(G))); print("degree = " + string(mult(G)));
LIB "primdec.lib"; list Lp = minAssGTZ(G); print("ncomp = " + string(size(Lp))); Lp;
quit;
