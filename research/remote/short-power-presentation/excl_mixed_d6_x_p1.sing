ring R = 1073741783, (u(1..12)), dp;
ideal I;
I[size(I)+1] = 1*u(1)*u(1);
I[size(I)+1] = 1*u(1)*u(2);
I[size(I)+1] = 1*u(2)*u(2);
I[size(I)+1] = 1*u(3)*u(3);
I[size(I)+1] = 1*u(3)*u(4);
I[size(I)+1] = 1*u(4)*u(4);
I[size(I)+1] = 1*u(5)*u(5);
I[size(I)+1] = 1*u(5)*u(6);
I[size(I)+1] = 1*u(6)*u(6);
I[size(I)+1] = 1*u(7)*u(7);
I[size(I)+1] = 1*u(7)*u(8);
I[size(I)+1] = 1*u(8)*u(8);
I[size(I)+1] = 1*u(9)*u(9);
I[size(I)+1] = 1*u(9)*u(10);
I[size(I)+1] = 1*u(10)*u(10);
I[size(I)+1] = 1*u(11)*u(11);
I[size(I)+1] = 1*u(11)*u(12);
I[size(I)+1] = 1*u(12)*u(12);
int t0 = timer;
option(redSB);
ideal G = std(I);
print("std_time = " + string(timer - t0));
print("dim = " + string(dim(G)));
print("vdim = " + string(vdim(G)));
print("degree:"); degree(G);
intvec hv = hilb(G, 1);
print("hilb1 = " + string(hv));
quit;
