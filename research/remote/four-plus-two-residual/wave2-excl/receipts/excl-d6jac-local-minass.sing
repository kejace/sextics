LIB "primdec.lib"; ring r=0,(w0,w1,w2,w3,w4,w5,w6,w7,w8,w9),dp; ideal I=-*w1^2,*w0*w1 - *w1*w4,-*w1*w5,-*w1*w6,*w0*w1 - *w1*w7,-*w2^2,*w0*w1 + *w0*w2 - *w1*w3 - *w2*w3,*w0*w2 - *w2*w4,-*w2*w5,-*w2*w6,*w0*w1 + *w0*w2 - *w1*w3 - *w2*w7,*w0*w1 + *w0*w2 - *w1*w3 - *w2*w8 - *w2*w9,-*w0^2 + *w0*w1 + *w0*w3 + *w1*w2 - *w1*w3 - *w3^2,*w0*w5 - *w3*w5,*w0^2 - *w0*w1 - *w0*w3 + *w0*w4 + *w0*w6 - *w0*w7 - *w1*w2 + *w1*w3 + *w3*w4 - *w3*w6 + *w3*w7 - *w4^2,*w0*w5 - *w4*w5,*w0*w6 - *w4*w6,*w0^2 - *w0*w1 - *w0*w3 - *w0*w4 + *w0*w6 + *w0*w7 - *w0*w8 - *w0*w9 - *w1*w2 + *w1*w3 + *w1*w8 + *w1*w9 + *w3*w4 - *w3*w6 + *w3*w7 + *w3*w8 + *w3*w9 - *w4*w7 - *w4*w8 - *w4*w9,-*w5^2,-*w0^2 - *w0*w1 - *w0*w3 + *w0*w4 + *w0*w6 + *w0*w7 - *w1*w2 + *w1*w3 + *w3*w4 - *w3*w6 + *w3*w7 - *w4*w7 - *w5*w6,*w0*w5 + *w0*w6 - *w3*w6 - *w5*w7,*w0^2 - *w0*w1 - *w0*w3 - *w0*w4 + *w0*w5 + *w0*w6 - *w0*w7 - *w0*w8 - *w0*w9 - *w1*w2 - *w1*w3 + *w1*w8 + *w1*w9 + *w3*w4 - *w3*w6 + *w3*w7 + *w3*w8 + *w3*w9 - *w5*w8 - *w5*w9,-*w6^2,*w0*w6 + *w3*w6 - *w6*w7,*w0*w6 + *w3*w6 - *w6*w8 - *w6*w9,-*w0^2 - *w0*w1 + *w0*w3 + *w0*w4 - *w0*w6 + *w0*w7 + *w1*w2 + *w1*w3 - *w3*w4 + *w3*w6 + *w3*w7 - *w7^2,-*w0^2 + *w0*w1 + *w0*w3 + *w0*w4 - *w0*w6 + *w0*w7 + *w0*w8 + *w0*w9 + *w1*w2 + *w1*w3 - *w1*w8 - *w1*w9 - *w3*w4 + *w3*w6 - *w3*w7 - *w3*w8 - *w3*w9 - *w4*w7 - *w7*w8 - *w7*w9,*w0^2 - *w0*w1 - *w0*w3 - *w0*w4 + *w0*w6 + *w0*w7 + *w0*w8 + *w0*w9 - *w1*w2 + *w1*w3 + *w1*w8 + *w1*w9 + *w3*w4 - *w3*w6 + *w3*w7 + *w3*w8 + *w3*w9 - *w4*w7 - *w8*w9,*w0^2 - *w0*w1 - *w0*w3 - *w0*w4 + *w0*w6 + *w0*w7 + *w0*w8 + *w0*w9 - *w1*w2 + *w1*w3 + *w1*w8 + *w1*w9 + *w3*w4 - *w3*w6 + *w3*w7 + *w3*w8 + *w3*w9 - *w4*w7 - *w8^2 - *w9^2; ideal G=std(I); print("dim:"); print(dim(G)); list L=minAssGTZ(I); print("n components:"); print(size(L)); int i; for(i=1;i<=size(L);i++){ print("component"); print(L[i]); print("dim"); print(dim(std(L[i]))); } quit;