ring r = 0,(X0,X1,X2,Y0,Y1,Y2),dp;
poly F = X0^6 + 5/7*X0^5*X1 + 5/7*X0^3*X1*Y0*Y1 + 10/7*X0*X1^5 + 10/7*X0*X1*Y0^3*Y1 + X1^6 + X2^6 + 15/7*X2^4*Y2^2 + 10/7*X2^2*Y2^4 + Y0^6 + 5/7*Y0^5*Y1 + 15/7*Y0*Y1^5 + Y1^6 + Y2^6;
ideal J = std(jacob(F));
"X smooth (dim V(jacob F)=0):", dim(J), " Milnor 5^6=15625:", vdim(J);
"A=X0^3Y0^3 reduced mod J (nonzero => nonzero class):", reduce(X0^3*Y0^3, J);
// W_H singular locus: ambient singular stratum X=Y=0 (weight-2 line), W meets it in s^3+t^3=0
ring rw = 0,(X0,X1,Y0,Y1,s,t),wp(1,1,1,1,2,2);
poly W = X0^6 + 5/7*X0^5*X1 + 5/7*X0^3*X1*Y0*Y1 + 10/7*X0*X1^5 + 10/7*X0*X1*Y0^3*Y1 + X1^6 + Y0^6 + 5/7*Y0^5*Y1 + 15/7*Y0*Y1^5 + Y1^6 + s^3 + t^3;
ideal L = W, X0, X1, Y0, Y1;
"W cap {X=Y=0}:", std(L);
"deg of that intersection (points on weighted line P(2,2)):", vdim(std(L)) ; 
quit;
