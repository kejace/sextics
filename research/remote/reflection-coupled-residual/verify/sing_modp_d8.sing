// Second-tool (Singular) computation of normal forms of A*m mod J for all Y-even degree-8 monomials m, char 1000003.
ring r = 1000003, (X0,X1,X2,Y0,Y1,Y2), dp;
poly F = (1)*X0^6 + (5/7)*X0^3*X1*Y0*Y1 + (5/7)*X0*X1*Y0^3*Y1 + (5/7)*X0*X1*Y0^2*Y2^2 + (10/7)*X0*X1*Y1^2*Y2^2 + (15/7)*X0*X2^3*Y0*Y1 + (1)*X1^6 + (10/7)*X1^3*X2*Y0*Y1 + (5/7)*X1*X2*Y0*Y1^3 + (1)*X2^6 + (1)*Y0^6 + (1)*Y1^6 + (1)*Y2^6;
poly A = (1)*X0^3*Y0^3;
ideal J = jacob(F);
option(redSB);
degBound = 14;
int t0 = timer;
ideal G = std(J);
"std(J) truncated at 14 mod 1000003: size", size(G), " time", timer - t0;
ideal M = maxideal(8);
int i; int cnt = 0;
link l = ":w nf_d8_p1000003.txt";
for (i = 1; i <= size(M); i++) {
  intvec e = leadexp(M[i]);
  if ((e[4] + e[5] + e[6]) % 2 == 0) {
    cnt++;
    write(l, string(M[i]) + " | " + string(reduce(A*M[i], G)));
  }
}
close(l);
"Y-even degree-8 monomials:", cnt;
"normal form of A:", reduce(A, G);
quit;
