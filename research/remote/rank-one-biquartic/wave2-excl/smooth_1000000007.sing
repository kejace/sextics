ring r = 1000000007, (X0,X1,X2,Y0,Y1,Y2), dp;
poly F = 7*X0^6 + 5*X0^5*X1 + 5*X0^4*Y0^2 + 5*X0^4*Y0*Y1 + 10*X0^4*Y1*Y2 + 15*X0^4*Y2^2 + 10*X0^3*X1*Y0^2 + 10*X0^3*X1*Y0*Y1 + 20*X0^3*X1*Y1*Y2 + 30*X0^3*X1*Y2^2 + 5*X0^2*X1^3*X2 + 5*X0^2*X1^2*Y0^2 + 5*X0^2*X1^2*Y0*Y1 + 10*X0^2*X1^2*Y1*Y2 + 15*X0^2*X1^2*Y2^2 + 20*X0^2*X1*X2*Y0^2 + 20*X0^2*X1*X2*Y0*Y1 + 40*X0^2*X1*X2*Y1*Y2 + 60*X0^2*X1*X2*Y2^2 + 30*X0^2*X2^2*Y0^2 + 30*X0^2*X2^2*Y0*Y1 + 60*X0^2*X2^2*Y1*Y2 + 90*X0^2*X2^2*Y2^2 + 20*X0*X1^2*X2*Y0^2 + 20*X0*X1^2*X2*Y0*Y1 + 40*X0*X1^2*X2*Y1*Y2 + 60*X0*X1^2*X2*Y2^2 + 30*X0*X1*X2^2*Y0^2 + 30*X0*X1*X2^2*Y0*Y1 + 60*X0*X1*X2^2*Y1*Y2 + 90*X0*X1*X2^2*Y2^2 + 15*X0*X2^5 + 7*X1^6 + 10*X1^5*X2 + 20*X1^2*X2^2*Y0^2 + 20*X1^2*X2^2*Y0*Y1 + 40*X1^2*X2^2*Y1*Y2 + 60*X1^2*X2^2*Y2^2 + 60*X1*X2^3*Y0^2 + 60*X1*X2^3*Y0*Y1 + 120*X1*X2^3*Y1*Y2 + 180*X1*X2^3*Y2^2 + 7*X2^6 + 45*X2^4*Y0^2 + 45*X2^4*Y0*Y1 + 90*X2^4*Y1*Y2 + 135*X2^4*Y2^2 + 7*Y0^6 + 10*Y0^5*Y1 + 10*Y0^3*Y1*Y2^2 + 5*Y0*Y2^5 + 7*Y1^6 + 15*Y1^5*Y2 + 7*Y2^6;
ideal J = jacob(F);
int t0 = timer;
ideal G = std(J);
print("prime 1000000007: dim(S/J) = " + string(dim(G)) + "  vdim = " + string(vdim(G)) + "  time = " + string(timer - t0));
quit;
