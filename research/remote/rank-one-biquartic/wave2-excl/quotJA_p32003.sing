poly f = (1)*X0^6+(5/7)*X0^5*X1+(5/7)*X0^2*X1^3*X2+(15/7)*X0*X2^5+(1)*X1^6+(10/7)*X1^5*X2+(1)*X2^6; poly g = (1)*Y0^6+(10/7)*Y0^5*Y1+(10/7)*Y0^3*Y1*Y2^2+(5/7)*Y0*Y2^5+(1)*Y1^6+(15/7)*Y1^5*Y2+(1)*Y2^6; poly L = (1)*X0^2+(1)*X0*X1+(2)*X1*X2+(3)*X2^2; poly M = (1)*Y0^2+(1)*Y0*Y1+(2)*Y1*Y2+(3)*Y2^2;
ideal J = jacob(F);
int tt = timer;
ideal GJ = std(J);
"std(J) size", size(GJ), "time", timer - tt;
"Disc in J:", reduce(Disc, GJ) == 0;
"A in J:", reduce(A, GJ) == 0;
"f*g in J:", reduce(f*g, GJ) == 0;  "L^2*M*f in J:", reduce(L^2*M*f, GJ) == 0; "f^2 in J:", reduce(f^2, GJ) == 0; "g^2 in J:", reduce(g^2, GJ) == 0;
tt = timer;
ideal JA = quotient(GJ, A);
"quotient time", timer - tt;
ideal GA = std(JA);
"HF S/(J:A) degrees 0..19:";
int k; intvec hf;
for (k = 0; k <= 19; k++) { hf[k+1] = size(kbase(GA, k)); }
hf;
"HF S/J degrees 0..24:";
intvec hj;
for (k = 0; k <= 24; k++) { hj[k+1] = size(kbase(GJ, k)); }
hj;
ideal MG = minbase(JA);
"minimal generators of (J:A):", size(MG);
intvec dg;
for (k = 1; k <= size(MG); k++) { dg[k] = deg(MG[k]); }
"degree counts (deg: count)";
int dd; int cnt;
for (dd = 5; dd <= 12; dd++) { cnt = 0; for (k = 1; k <= size(MG); k++) { if (dg[k] == dd) { cnt++; } } dd, cnt; }
"non-J generators of degree 7 and 8 (leading monomials):";
for (k = 1; k <= size(MG); k++) { if (dg[k] == 7 or dg[k] == 8) { dg[k], leadmonom(MG[k]), "inJ", reduce(MG[k], GJ) == 0, "nterms", size(MG[k]); } }
quit;
