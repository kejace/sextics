ring r = 1000000007, (c1,c2,c3), dp;
ideal I = 807548520*c1^2+666127338*c1*c2+826441595*c1*c3+68246584*c2^2+746447759*c2*c3+20165905*c3^2,
130527073*c1^2+692804908*c1*c2+204396841*c1*c3+911963823*c2^2+460595999*c2*c3+170431092*c3^2;
ideal G = std(I); "DIM", dim(G); if (dim(G) <= 1) { "VDIM", vdim(G); } "LEAD"; lead(G); quit;
