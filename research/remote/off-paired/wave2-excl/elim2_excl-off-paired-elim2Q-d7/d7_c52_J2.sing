LIB "primdec.lib";
ring r = 0, (t0,t1), dp;
ideal J2 = (-3401222400000)*t1*t1,
(-3401222400000)*t1*t1,
(3401222400000)*t1*t1,
(-12754584000000)*t0*t0,
(2550916800000)*t0*t0,
(-2550916800000)*t0*t0,
(-2550916800000)*t0*t0,
(-6377292000000)*t0*t1,
(-6377292000000)*t0*t1,
(-6377292000000)*t0*t1,
(-6377292000000)*t0*t1,
(5952139200000)*t0*t1,
(-5952139200000)*t0*t1,
(-5952139200000)*t0*t1,
(5952139200000)*t0*t1,
(5952139200000)*t0*t1,
(8503056000000)*t0*t0,
(17006112000000)*t1*t1,
(-2976069600000)*t0*t1,
(-8503056000000)*t0*t1,
(6589868400000)*t0*t1,
(4464104400000)*t0*t1,
(-5526986400000)*t0*t1,
(4889257200000)*t0*t1,
(-13817466000000)*t0*t1,
(-6377292000000)*t0*t1,
(-20407334400000)*t0*t1,
(7652750400000)*t0*t0,
(-6377292000000)*t0*t1,
(-3401222400000)*t0*t0,
(-26359473600000)*t0*t1,
(-7652750400000)*t0*t0,
(8503056000000)*t0*t0,
(-3401222400000)*t0*t0;
ideal G = std(J2);
int dm = dim(G);
print("DIMJ2 " + string(dm));
if (dm > 0) {
  list L = minAssGTZ(J2);
  int i; int j;
  for (i = 1; i <= size(L); i++) {
    string s = "COMP " + string(i) + ":";
    for (j = 1; j <= size(L[i]); j++) { s = s + " " + string(L[i][j]) + " ;"; }
    print(s);
  }
}
quit;
