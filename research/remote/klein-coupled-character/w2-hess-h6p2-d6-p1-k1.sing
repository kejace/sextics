ring r = 1000003, (u0,u1,u2), dp;
option(redSB);
ideal I = 571441*u0*u0,
571466*u0*u0,
45*u0*u0,
428572*u0*u1+428572*u1*u0,
285713*u0*u2+285713*u2*u0,
999973*u1*u1,
857144*u1*u2+857144*u2*u1,
999973*u2*u2;
ideal G = std(I);
int dm = dim(G);
print("DIM " + string(dm) + " GBSIZE " + string(size(G)) + " VARS " + string(nvars(r)) + " NEQ " + string(size(I)));
if (dm == 0) { print("VDIM " + string(vdim(G))); }
quit;
