ring R = 1000003, (u0,u1,u2,u3,u4,u5), dp;
ideal I = 30*u5^2,
30*u4^2,
30*u3^2,
142859*u0*u3,
142859*u1*u3,
142859*u1*u4+142859*u2*u3+551019*u3*u5,
142859*u2*u4,
555557*u0*u4,
857154*u0^2,
714305*u0*u1,
857154*u1^2,
714305*u0*u2,
714305*u1*u2,
857154*u2^2,
777779*u0*u4+142859*u3*u4,
857154*u0*u4,
857154*u0*u5+857154*u1*u4+306105*u3*u5,
857154*u1*u5,
