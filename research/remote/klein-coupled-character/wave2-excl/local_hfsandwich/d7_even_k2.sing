LIB "poly.lib";
ring R = 0, (u0,u1,u2,u3,u4,u5,u6,u7,u8,u9,u10,l1,l2,l3,l4,l5,m0), dp;
ideal P = u0-l1*m0,u1-l2*m0,u4-l3*m0,u6-l4*m0,u8-l5*m0,(210)*l1*l1+(30)*l1*l4+(-30)*l1*l5+(-250)*l2*l2+(-90)*l2*l3+(152)*l2*l4+(62)*l2*l5+(50)*l3*l3+(10)*l3*l4+(-30)*l3*l5+(-405)*l4*l4+(152)*l4*l5+(-305)*l5*l5,(210)*l1*l2+(-60)*l1*l4+(60)*l1*l5+(-340)*l2*l2+(180)*l2*l3+(74)*l2*l4+(254)*l2*l5+(-100)*l3*l3+(-20)*l3*l4+(60)*l3*l5+(-135)*l4*l4+(74)*l4*l5+(-335)*l5*l5,(70)*l1*l3+(60)*l1*l4+(10)*l1*l5+(-150)*l2*l2+(30)*l2*l3+(66)*l2*l4+(96)*l2*l5+(-75)*l3*l3+(20)*l3*l4+(10)*l3*l5+(-215)*l4*l4+(66)*l4*l5+(-190)*l5*l5;
ideal IL = eliminate(P, l1*l2*l3*l4*l5*m0);
ring S = 0, (u0,u1,u2,u3,u4,u5,u6,u7,u8,u9,u10), dp;
ideal IL = imap(R, IL);
ideal ILfull = IL, u2,u3,u5,u7,u9,u10;
ideal SIL = std(ILfull);
"IL_gb_size", size(SIL), "dim", dim(SIL), "mult", mult(SIL);
intvec h1 = hilb(SIL, 1);
"HS_L", h1;
ideal LEAD = u10^2,u9^1*u10^1,u7^1*u10^1,u0^1*u10^1,u9^2,u7^1*u9^1,u3^1*u9^1,u1^1*u9^1,u0^1*u9^1,u7^2,u5^1*u7^1,u1^1*u7^1,u0^1*u7^1,u5^2,u2^1*u5^1,u1^1*u5^1,u0^1*u5^1,u3^2,u2^1*u3^1,u1^1*u3^1,u0^1*u3^1,u2^2,u1^1*u2^1,u0^1*u2^1,u1^2,u0^1*u1^1,u0^2,u6^2*u10^1,u5^1*u6^1*u10^1,u4^1*u6^1*u10^1,u3^1*u6^1*u10^1,u1^1*u6^1*u10^1,u4^1*u5^1*u10^1,u4^2*u10^1,u3^1*u4^1*u10^1,u2^1*u4^1*u10^1,u1^1*u4^1*u10^1,u6^2*u9^1,u5^1*u6^1*u9^1,u4^1*u6^1*u9^1,u2^1*u6^1*u9^1,u4^1*u5^1*u9^1,u4^2*u9^1,u2^1*u4^1*u9^1,u6^2*u7^1,u4^1*u6^1*u7^1,u3^1*u6^1*u7^1,u2^1*u6^1*u7^1,u4^2*u7^1,u3^1*u4^1*u7^1,u2^1*u4^1*u7^1,u5^1*u6^2,u3^1*u6^2,u2^1*u6^2,u4^1*u5^1*u6^1,u3^1*u5^1*u6^1,u3^1*u4^1*u6^1,u2^1*u4^1*u6^1,u4^2*u5^1,u3^1*u4^1*u5^1,u3^1*u4^2,u2^1*u4^2,u1^1*u4^2,u0^1*u4^2,u6^1*u8^2*u10^1,u5^1*u8^2*u10^1,u4^1*u8^2*u10^1,u3^1*u8^2*u10^1,u2^1*u8^2*u10^1,u1^1*u8^2*u10^1,u2^1*u6^1*u8^1*u10^1,u3^1*u5^1*u8^1*u10^1,u6^1*u8^2*u9^1,u5^1*u8^2*u9^1,u4^1*u8^2*u9^1,u2^1*u8^2*u9^1,u6^1*u7^1*u8^2,u4^1*u7^1*u8^2,u3^1*u7^1*u8^2,u2^1*u7^1*u8^2,u5^1*u6^1*u8^2,u3^1*u6^1*u8^2,u2^1*u6^1*u8^2,u4^1*u5^1*u8^2,u3^1*u5^1*u8^2,u3^1*u4^1*u8^2,u2^1*u4^1*u8^2,u4^4,u8^4*u10^1,u8^4*u9^1,u7^1*u8^4,u5^1*u8^4,u3^1*u8^4,u2^1*u8^4;
ideal SLEAD = std(LEAD);
"lead_dim", dim(SLEAD), "lead_mult", mult(SLEAD);
