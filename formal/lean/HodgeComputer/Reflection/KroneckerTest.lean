def F : Poly := toC tF
def A : Poly := toC tA
def D : Poly := toC tD
def Q : Poly := toC tQ
def N0 : Poly := toC tN0
def N1 : Poly := toC tN1
def N2 : Poly := toC tN2
def N3 : Poly := toC tN3
def N4 : Poly := toC tN4
def N5 : Poly := toC tN5

def N : Fin 6 → Poly := fun i =>
  if i.val = 0 then N0 else if i.val = 1 then N1 else if i.val = 2 then N2 else
  if i.val = 3 then N3 else if i.val = 4 then N4 else N5

/-- Left side of `e1`: `q · Σᵢ ∂ᵢF · Nᵢ` with `q = 1`. -/
def L1 : E :=
  .smulN 1 (.add (.mul (.pd 0 tF) (.poly tN0)) (.add (.mul (.pd 1 tF) (.poly tN1))
    (.add (.mul (.pd 2 tF) (.poly tN2)) (.add (.mul (.pd 3 tF) (.poly tN3))
      (.add (.mul (.pd 4 tF) (.poly tN4)) (.mul (.pd 5 tF) (.poly tN5)))))))

/-- Right side of `e1`: `A · D`. -/
def R1 : E := .mul (.poly tA) (.poly tD)

theorem e1_core : denC L1 = denC R1 :=
  soundN (m := 21) (W := 61) L1 R1 (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel)

theorem e1 : (1 : Poly) * directional F N = A * D := by
  simp only [directional, Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero]
  change (1 : Poly) * (pderiv (0 : Fin 6) F * N0 + (pderiv (1 : Fin 6) F * N1 +
    (pderiv (2 : Fin 6) F * N2 + (pderiv (3 : Fin 6) F * N3 + (pderiv (4 : Fin 6) F * N4 +
    pderiv (5 : Fin 6) F * N5))))) = A * D
  have h := e1_core
  simp only [L1, R1, denC_smulN, denC_add, denC_mul, denC_poly, denC_pd, Nat.cast_one] at h
  simpa only [F, A, D, N0, N1, N2, N3, N4, N5] using h

/-- Left side of `e2`: `D · Σᵢ ∂ᵢNᵢ − Σᵢ ∂ᵢD · Nᵢ`. -/
def L2 : E :=
  .sub (.mul (.poly tD) (.add (.pd 0 tN0) (.add (.pd 1 tN1) (.add (.pd 2 tN2)
      (.add (.pd 3 tN3) (.add (.pd 4 tN4) (.pd 5 tN5)))))))
    (.add (.mul (.pd 0 tD) (.poly tN0)) (.add (.mul (.pd 1 tD) (.poly tN1))
      (.add (.mul (.pd 2 tD) (.poly tN2)) (.add (.mul (.pd 3 tD) (.poly tN3))
        (.add (.mul (.pd 4 tD) (.poly tN4)) (.mul (.pd 5 tD) (.poly tN5)))))))

/-- Right side of `e2`: `F ^ q · Q`. -/
def R2 : E := .mul (.pow (.poly tF) 1) (.poly tQ)

theorem e2_core : denC L2 = denC R2 :=
  soundN (m := 21) (W := 61) L2 R2 (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel)

theorem e2 : divergenceNumerator D N = F ^ 1 * Q := by
  simp only [divergenceNumerator, divergence, directional, Fin.sum_univ_succ, Fin.sum_univ_zero,
    add_zero]
  change D * (pderiv (0 : Fin 6) N0 + (pderiv (1 : Fin 6) N1 + (pderiv (2 : Fin 6) N2 +
    (pderiv (3 : Fin 6) N3 + (pderiv (4 : Fin 6) N4 + pderiv (5 : Fin 6) N5))))) -
    (pderiv (0 : Fin 6) D * N0 + (pderiv (1 : Fin 6) D * N1 + (pderiv (2 : Fin 6) D * N2 +
    (pderiv (3 : Fin 6) D * N3 + (pderiv (4 : Fin 6) D * N4 + pderiv (5 : Fin 6) D * N5))))) =
    F ^ 1 * Q
  have h := e2_core
  simp only [L2, R2, denC_sub, denC_add, denC_mul, denC_pow, denC_poly, denC_pd] at h
  simpa only [F, D, Q, N0, N1, N2, N3, N4, N5] using h

theorem denominator_homogeneous : D.IsHomogeneous 10 :=
  toC_isHomogeneous 10 tD (by decide +kernel)

theorem denominator_ne_zero : D ≠ 0 :=
  toC_ne_zero_of_evalPT ![1, 1, 1, 1, 1, 1] tD (by decide +kernel)

end

