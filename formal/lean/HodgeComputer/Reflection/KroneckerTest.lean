import HodgeComputer.Reflection.Kronecker

/-!
# Checks for the Kronecker-substitution checker

A small identity exercising every expression constructor, followed by the cleared certificate
equations `e1` and `e2` of the accepted `m3-coupled` witness (`data/m3-coupled/witness.json`,
scaled by `6` to integer coefficients), each certified by `soundN` with `decide +kernel` side
goals. The `#print axioms` commands display the audited axiom set of the soundness theorems and of
these applications. The trees were generated by the capacity-study generator described in the
directory `README.md`.
-/

set_option autoImplicit false
-- The kernel caches every intermediate Kronecker value of a declaration; sequential elaboration
-- bounds the peak memory by the largest declaration instead of the sum of concurrent ones.
set_option Elab.async false

namespace HodgeComputer.KroneckerTest

open MvPolynomial HodgeTestbed HodgeComputer.Kronecker

/-! ## A small identity

With `P = X0 + 2 X1` and `S = P ^ 2 = X0 ^ 2 + 4 X0 X1 + 4 X1 ^ 2`, the identity
`2 * (P * ∂₀ S) = 4 * P ^ 2` has degree `2 < m = 3`; the ℓ¹ bounds give `36 + 36 < 2 ^ 8`. -/

noncomputable def tP : PT := .node (.leaf ⟨1, 0, 0, 0, 0, 0⟩ 1) (.leaf ⟨0, 1, 0, 0, 0, 0⟩ 2)

noncomputable def tS : PT :=
  .node (.leaf ⟨2, 0, 0, 0, 0, 0⟩ 1) (.node (.leaf ⟨1, 1, 0, 0, 0, 0⟩ 4) (.leaf ⟨0, 2, 0, 0, 0, 0⟩ 4))

noncomputable def smallL : E := .smulN 2 (.mul (.poly tP) (.pd 0 tS))

noncomputable def smallR : E := .smulN 4 (.pow (.poly tP) 2)

theorem small_core : denC smallL = denC smallR :=
  soundN (m := 3) (W := 8) smallL smallR (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)

theorem small : (2 : Poly) * (toC tP * pderiv (0 : Fin 6) (toC tS)) = (4 : Poly) * toC tP ^ 2 := by
  have h := small_core
  simp only [smallL, smallR, denC_smulN, denC_mul, denC_pd, denC_pow, denC_poly,
    Nat.cast_ofNat] at h
  exact h

